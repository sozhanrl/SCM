FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=elden-care-super-secret-development-key-2026

# Database Configuration
# Primary Target: MySQL (Change credentials as needed for your local or production MySQL server)
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/elden_care
# SQLite fallback option if MySQL service is not currently active on host:
# DATABASE_URL=sqlite:///instance/elden_care.db

# Upload configuration (16 MB max)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Password Reset Token Expiration (in seconds, e.g. 3600 = 1 hour)
RESET_TOKEN_EXPIRATION_SECONDS=3600

# Email Delivery Mode: "console" (logs token/link for dev), "smtp" (for live mail delivery)
MAIL_BACKEND=console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@eldencare.com
